{#
    Lizenzseite der KI-Kennzeichnung (System -> Lizenz KI-Kennzeichnung).

    Twig statt .html5: Contao 6 rendert keine .html5-Vorlagen mehr - die Seite brach dort mit
    "Template ... is not defined" ab. Contao 5.3 und 5.7 nehmen eine gleichnamige Twig-Vorlage
    ebenfalls vorrangig (TemplateInheritance::renderTwigSurrogateIfExists); diese eine Fassung
    gilt also fuer alle unterstuetzten Versionen.

    Alle Texte kommen fertig aus LicenseLabels, hier steht kein Uebersetzungsaufruf. Escaped
    wird von Twig - auch die Adressen, obwohl Contao beide selbst baut.
#}
{% set armed = license.armed %}
{% set active = license.active %}
{% set type = license.type %}
{# Eine interne Lizenz (vom Hersteller ausgestellt) hat keinen Stripe-Kunden - es gibt dort nichts zu verwalten. #}
{% set internal = 'internal' == licensePlan %}

<div id="tl_buttons">
    <a href="{{ referer }}" class="header_back" title="{{ backTitle }}" accesskey="b">{{ backLabel }}</a>
    {% if armed %}
        <a href="{{ actionUrl ~ '&action=refresh_license' }}" class="header_sync" title="{{ labels['help.refresh'] }}">{{ labels['button.refresh'] }}</a>
        {% if active and internal %}
            {# Interne Lizenz: verlaengert sich selbst, kein Abrechnungskonto. Keine Schaltflaechen. #}
        {% elseif active and 'full' == type %}
            <a href="{{ actionUrl ~ '&action=manage_billing' }}" class="header_edit_all" title="{{ labels['help.manage'] }}">{{ labels['button.manage'] }}</a>
        {% elseif active %}
            {# Laufende Testphase: den Wechsel ins Abo anbieten. Ein Abrechnungskonto gibt es noch nicht. #}
            <a href="{{ actionUrl ~ '&action=subscribe' }}" class="header_new" title="{{ labels['help.subscribe'] }}">{{ labels['button.subscribe'] }}</a>
        {% elseif internal %}
            {# Interne Lizenz, die nicht mehr wirkt (widerrufen, abgelaufen): kaufen ist der Ausweg, verwalten gibt es nicht. #}
            <a href="{{ actionUrl ~ '&action=subscribe' }}" class="header_new" title="{{ labels['help.subscribe'] }}">{{ labels['button.subscribe'] }}</a>
        {% elseif 'full' == type %}
            {# Bezahlte Lizenz ueber die Karenz hinaus abgelaufen: dafuer braucht es das Portal (Zahlungsmittel, Abo neu starten), eine zweite Testphase lehnt der Server ab. #}
            <a href="{{ actionUrl ~ '&action=subscribe' }}" class="header_new" title="{{ labels['help.subscribe'] }}">{{ labels['button.subscribe'] }}</a>
            <a href="{{ actionUrl ~ '&action=manage_billing' }}" class="header_edit_all" title="{{ labels['help.manage'] }}">{{ labels['button.manage'] }}</a>
        {% else %}
            <a href="{{ actionUrl ~ '&action=start_trial' }}" class="header_new" title="{{ labels['help.trial'] }}">{{ labels['button.trial'] }}</a>
            <a href="{{ actionUrl ~ '&action=subscribe' }}" class="header_new" title="{{ labels['help.subscribe'] }}">{{ labels['button.subscribe'] }}</a>
        {% endif %}
    {% endif %}
</div>

{# Von Message::generate() erzeugtes Markup des Cores. #}
{{ messages|raw }}

{% if update %}
    {# Nur ein Hinweis: aktualisiert wird ueber den Contao Manager oder Composer, nicht von hier aus. #}
    <div class="tl_message">
        <p class="{{ update.security ? 'tl_error' : 'tl_info' }}">
            {{ update.text }}
            {% if update.url %}
                <a href="{{ update.url }}" target="_blank" rel="noreferrer noopener">{{ update.linkLabel }}</a>
            {% endif %}
        </p>
    </div>
{% endif %}

{% if not armed %}
    <div class="tl_message">
        <p class="tl_info">{{ labels['notice.not_enforced'] }}</p>
    </div>
{% elseif not active %}
    <div class="tl_message">
        <p class="tl_error">{{ labels['notice.inactive'] }}</p>
    </div>
{% elseif license.in_grace %}
    <div class="tl_message">
        <p class="tl_info">{{ labels['notice.grace'] }}</p>
    </div>
{% endif %}

<h2 class="sub_headline">{{ labels['headline'] }}</h2>

<table class="tl_show">
    <tbody>
        <tr>
            <td class="tl_file_list">{{ labels['field.state'] }}</td>
            <td class="tl_file_list">
                {% if not armed %}
                    {{ labels['state.not_enforced'] }}
                {% elseif active %}
                    <strong class="tl_green">●</strong> {{ labels['state.active'] }}
                    {% if license.in_grace %}
                        <span class="tl_orange">({{ labels['state.grace'] }})</span>
                    {% endif %}
                {% else %}
                    <strong class="tl_red">●</strong> {{ labels['state.inactive'] }}
                    ({{ labels['reason'] }})
                {% endif %}
            </td>
        </tr>
        {% if armed %}
            <tr>
                <td class="tl_file_list">{{ labels['field.type'] }}</td>
                <td class="tl_file_list">
                    {% if internal %}
                        {{ labels['type.internal'] }}
                    {% elseif 'trial' == type %}
                        {{ labels['type.trial'] }}
                    {% elseif 'full' == type %}
                        {{ labels['type.full'] }}
                    {% else %}
                        –
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="tl_file_list">{{ labels['field.expiry'] }}</td>
                <td class="tl_file_list">
                    {% if internal %}
                        {{ labels['expiry.unlimited'] }}
                    {% elseif license.expires_at > 0 %}
                        {{ license.expires_at|date('d.m.Y H:i') }}
                        ({{ labels['days_left'] }})
                    {% else %}
                        –
                    {% endif %}
                </td>
            </tr>
        {% endif %}
        <tr>
            <td class="tl_file_list">{{ labels['field.domain'] }}</td>
            <td class="tl_file_list">{{ license.domain ?: '–' }}</td>
        </tr>
        <tr>
            <td class="tl_file_list">{{ labels['field.file'] }}</td>
            <td class="tl_file_list"><code>{{ licenseFile }}</code></td>
        </tr>
    </tbody>
</table>

{# Ohne tl_tip: das kuerzt im Backend auf eine Zeile mit Auslassungspunkten - fuer ganze Absaetze falsch. #}
<div class="tl_listing_container">
    <p class="tl_help">{{ labels['help.scope'] }}</p>
    <p class="tl_help">{{ labels['help.file'] }}</p>
</div>
