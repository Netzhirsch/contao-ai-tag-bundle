<?php
/** @var \Contao\BackendTemplate $this */

/*
 * Achtung: dieser Vorlage duerfen keine Objekte uebergeben werden, die aufrufbar sind.
 * Contaos Template::__get() fuehrt sie beim Lesen sofort aus - eine uebergebene Closure
 * bricht die Seite mit "Too few arguments" ab. Deshalb kommen alle Texte als fertige
 * Zeichenketten aus LicenseLabels.
 */

/** @var array<string, string> $labels */
$labels = $this->labels;

/** @var array{active: bool, armed: bool, type: string, plan: string, reason: string, domain: string, domain_verified: bool, expires_at: int, days_left: int, in_grace: bool} $license */
$license = $this->license;

$plan = (string) $this->licensePlan;
$armed = (bool) $license['armed'];
$active = (bool) $license['active'];
$type = (string) $license['type'];

// Eine interne Lizenz (vom Hersteller ausgestellt) hat keinen Stripe-Kunden - es gibt
// dort nichts zu verwalten, das Portal koennte nur mit einem Fehler antworten.
$internal = 'internal' === $plan;

$actionUrl = (string) $this->actionUrl;
$actionLink = static fn (string $action): string => $actionUrl.'&amp;action='.$action;
$e = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES);
?>

<div id="tl_buttons">
    <a href="<?= $this->referer ?>" class="header_back" title="<?= $e((string) $this->backTitle) ?>" accesskey="b" onclick="Backend.getScrollOffset()"><?= $this->backLabel ?></a>
    <?php if ($armed): ?>
        <a href="<?= $actionLink('refresh_license') ?>" class="header_sync" title="<?= $e($labels['help.refresh']) ?>"><?= $e($labels['button.refresh']) ?></a>
        <?php if ($active && $internal): ?>
            <?php // Interne Lizenz: verlaengert sich selbst, kein Abrechnungskonto. Keine Schaltflaechen. ?>
        <?php elseif ($active && 'full' === $type): ?>
            <a href="<?= $actionLink('manage_billing') ?>" class="header_edit_all" title="<?= $e($labels['help.manage']) ?>"><?= $e($labels['button.manage']) ?></a>
        <?php elseif ($active): ?>
            <?php // Laufende Testphase: den Wechsel ins Abo anbieten. Ein Abrechnungskonto gibt es noch nicht. ?>
            <a href="<?= $actionLink('subscribe') ?>" class="header_new" title="<?= $e($labels['help.subscribe']) ?>"><?= $e($labels['button.subscribe']) ?></a>
        <?php elseif ($internal): ?>
            <?php // Interne Lizenz, die nicht mehr wirkt (widerrufen, abgelaufen): kaufen ist der Ausweg, verwalten gibt es nicht. ?>
            <a href="<?= $actionLink('subscribe') ?>" class="header_new" title="<?= $e($labels['help.subscribe']) ?>"><?= $e($labels['button.subscribe']) ?></a>
        <?php elseif ('full' === $type): ?>
            <?php // Bezahlte Lizenz ueber die Karenz hinaus abgelaufen: dafuer braucht es das Portal (Zahlungsmittel, Abo neu starten), eine zweite Testphase lehnt der Server ab. ?>
            <a href="<?= $actionLink('subscribe') ?>" class="header_new" title="<?= $e($labels['help.subscribe']) ?>"><?= $e($labels['button.subscribe']) ?></a>
            <a href="<?= $actionLink('manage_billing') ?>" class="header_edit_all" title="<?= $e($labels['help.manage']) ?>"><?= $e($labels['button.manage']) ?></a>
        <?php else: ?>
            <a href="<?= $actionLink('start_trial') ?>" class="header_new" title="<?= $e($labels['help.trial']) ?>"><?= $e($labels['button.trial']) ?></a>
            <a href="<?= $actionLink('subscribe') ?>" class="header_new" title="<?= $e($labels['help.subscribe']) ?>"><?= $e($labels['button.subscribe']) ?></a>
        <?php endif; ?>
    <?php endif; ?>
</div>

<?= $this->messages ?>

<?php if (!$armed): ?>
    <div class="tl_message">
        <p class="tl_info"><?= $e($labels['notice.not_enforced']) ?></p>
    </div>
<?php elseif (!$active): ?>
    <div class="tl_message">
        <p class="tl_error"><?= $e($labels['notice.inactive']) ?></p>
    </div>
<?php elseif ($license['in_grace']): ?>
    <div class="tl_message">
        <p class="tl_info"><?= $e($labels['notice.grace']) ?></p>
    </div>
<?php endif; ?>

<h2 class="sub_headline"><?= $e($labels['headline']) ?></h2>

<table class="tl_show">
    <tbody>
        <tr>
            <td class="tl_file_list"><?= $e($labels['field.state']) ?></td>
            <td class="tl_file_list">
                <?php if (!$armed): ?>
                    <?= $e($labels['state.not_enforced']) ?>
                <?php elseif ($active): ?>
                    <strong class="tl_green">&#9679;</strong> <?= $e($labels['state.active']) ?>
                    <?php if ($license['in_grace']): ?>
                        <span class="tl_orange">(<?= $e($labels['state.grace']) ?>)</span>
                    <?php endif; ?>
                <?php else: ?>
                    <strong class="tl_red">&#9679;</strong> <?= $e($labels['state.inactive']) ?>
                    (<?= $e($labels['reason']) ?>)
                <?php endif; ?>
            </td>
        </tr>
        <?php if ($armed): ?>
            <tr>
                <td class="tl_file_list"><?= $e($labels['field.type']) ?></td>
                <td class="tl_file_list">
                    <?php if ($internal): ?>
                        <?= $e($labels['type.internal']) ?>
                    <?php elseif ('trial' === $type): ?>
                        <?= $e($labels['type.trial']) ?>
                    <?php elseif ('full' === $type): ?>
                        <?= $e($labels['type.full']) ?>
                    <?php else: ?>
                        &ndash;
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <td class="tl_file_list"><?= $e($labels['field.expiry']) ?></td>
                <td class="tl_file_list">
                    <?php if ($internal): ?>
                        <?= $e($labels['expiry.unlimited']) ?>
                    <?php elseif ($license['expires_at'] > 0): ?>
                        <?= $e(date('d.m.Y H:i', (int) $license['expires_at'])) ?>
                        (<?= $e($labels['days_left']) ?>)
                    <?php else: ?>
                        &ndash;
                    <?php endif; ?>
                </td>
            </tr>
        <?php endif; ?>
        <tr>
            <td class="tl_file_list"><?= $e($labels['field.domain']) ?></td>
            <td class="tl_file_list"><?= '' !== (string) $license['domain'] ? $e((string) $license['domain']) : '&ndash;' ?></td>
        </tr>
        <tr>
            <td class="tl_file_list"><?= $e($labels['field.file']) ?></td>
            <td class="tl_file_list"><code><?= $e((string) $this->licenseFile) ?></code></td>
        </tr>
    </tbody>
</table>

<p class="tl_help tl_tip"><?= $e($labels['help.scope']) ?></p>
<p class="tl_help tl_tip"><?= $e($labels['help.file']) ?></p>
