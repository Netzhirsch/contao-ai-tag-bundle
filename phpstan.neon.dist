parameters:
    level: 6
    # Contao 5.3 (LTS) laeuft ab PHP 8.1 - so meldet PHPStan die Verwendung
    # neuerer Sprachfeatures, statt sie erst auf der Zielinstallation zu zeigen.
    phpVersion: 80100
    paths:
        - src
        - tests
    treatPhpDocTypesAsCertain: false
    # Contaos Templates sind Eigenschaftsbeutel: das Modul setzt seine Werte ueber die
    # magischen Zugriffsmethoden, das Template liest sie. Ohne diesen Eintrag meldet
    # PHPStan jede Template-Variable als undefinierte Eigenschaft. stdClass steht in der
    # Voreinstellung und muss hier mitgefuehrt werden, weil die Liste ersetzt wird.
    universalObjectCratesClasses:
        - stdClass
        - Contao\Template
