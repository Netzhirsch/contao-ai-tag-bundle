# Wird nur benutzt, wenn netzhirsch/contao-mcp-bundle nicht installiert werden kann
# (privates Repository, kein Token in der CI). Ohne dessen Basisklasse laesst sich
# src/Mcp nicht analysieren - der Lauf sagt in dem Fall ausdruecklich, dass dieser
# Teil ungeprueft bleibt.
includes:
    - phpstan.neon.dist

parameters:
    excludePaths:
        analyse:
            - src/Mcp
            - tests/Mcp
