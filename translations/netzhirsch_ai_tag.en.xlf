        <source>netzhirsch_ai_tag.preview.tagged</source>
        <target>With label</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.hint">
        <source>netzhirsch_ai_tag.preview.hint</source>
        <target>The preview shows the label at the size of this preview. In the delivered image size it scales accordingly, and below the legibility threshold it is omitted entirely.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.not_taggable">
        <source>netzhirsch_ai_tag.preview.not_taggable</source>
        <target>The label cannot be burnt into this format. Only the text alternative in the markup applies.</target>
      </trans-unit>
