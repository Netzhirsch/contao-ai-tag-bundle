<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="netzhirsch_ai_tag">
    <body>
      <trans-unit id="netzhirsch_ai_tag.label">
        <source>netzhirsch_ai_tag.label</source>
        <target>AI-generated</target>
        <note>Default legal wording for image labelling. As short as possible so it stays legible in small image sizes.</note>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.flag_set">
        <source>netzhirsch_ai_tag.log.flag_set</source>
        <target>AI label set: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.flag_unset">
        <source>netzhirsch_ai_tag.log.flag_unset</source>
        <target>AI label removed: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.text_changed">
        <source>netzhirsch_ai_tag.log.text_changed</source>
        <target>AI label wording changed: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.position_changed">
        <source>netzhirsch_ai_tag.log.position_changed</source>
        <target>AI label position changed: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.hint.format">
        <source>netzhirsch_ai_tag.hint.format</source>
        <target>"%file%" is not a raster image (e.g. SVG). The label cannot be burnt into the image and will only appear as a text alternative in the markup.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.hint.size">
        <source>netzhirsch_ai_tag.hint.size</source>
        <target>"%file%" is too small at %width%×%height% pixels for a legible label. It will only appear as a text alternative in the markup.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.label">
        <source>netzhirsch_ai_tag.preview.label</source>
        <target>Label preview</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.plain">
        <source>netzhirsch_ai_tag.preview.plain</source>
        <target>Without label</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.tagged">
        <source>netzhirsch_ai_tag.preview.tagged</source>
        <target>With label</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.hint">
        <source>netzhirsch_ai_tag.preview.hint</source>
        <target>The preview shows the label at the size of this preview. In the delivered image size it scales accordingly, and below the legibility threshold it is omitted entirely.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.not_taggable">
        <source>netzhirsch_ai_tag.preview.not_taggable</source>
        <target>The label cannot be burnt into this format. Only the text alternative in the markup applies.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.detection.declared">
        <source>netzhirsch_ai_tag.detection.declared</source>
        <target>This file declares itself as AI-generated in its metadata (%source%: %detail%).</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.detection.hint">
        <source>netzhirsch_ai_tag.detection.hint</source>
        <target>The metadata of this file points to an AI generator (%source%: %detail%). That is an indication, not a declaration.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.detection.decide">
        <source>netzhirsch_ai_tag.detection.decide</source>
        <target>Whether a label is required depends on the content - set it if the content falls under the obligation.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.detection.already_flagged">
        <source>netzhirsch_ai_tag.detection.already_flagged</source>
        <target>The label is set.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.coverage.label">
        <source>netzhirsch_ai_tag.coverage.label</source>
        <target>Legibility per image size</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.coverage.legible">
        <source>netzhirsch_ai_tag.coverage.legible</source>
        <target>legible</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.coverage.too_small">
        <source>netzhirsch_ai_tag.coverage.too_small</source>
        <target>too small - text alternative only</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.coverage.hint">
        <source>netzhirsch_ai_tag.coverage.hint</source>
        <target>Calculated for the image sizes configured in this installation. Where the label does not fit legibly it is omitted, and only the text alternative in the markup carries the information.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
