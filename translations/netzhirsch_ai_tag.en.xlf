      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.detection.hint">
        <source>netzhirsch_ai_tag.detection.hint</source>
        <target>The metadata of this file points to an AI generator (%source%: %detail%). That is an indication, not a declaration.</target>
      </trans-unit>
