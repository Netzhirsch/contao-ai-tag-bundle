      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.license.msg.billing_activated">
        <source>netzhirsch_ai_tag.license.msg.billing_activated</source>
        <target>Payment received – the subscription is active and the label is burnt in.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.license.msg.billing_pending">
        <source>netzhirsch_ai_tag.license.msg.billing_pending</source>
        <target>Payment received – the subscription is being activated. With SEPA this can take a moment; the licence unlocks by itself.</target>
      </trans-unit>
