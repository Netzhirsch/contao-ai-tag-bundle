      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.hint.format">
        <source>netzhirsch_ai_tag.hint.format</source>
        <target>"%file%" ist kein Rasterbild (z. B. SVG). Die Kennzeichnung kann nicht ins Bild gebrannt werden und erscheint nur als Textalternative im Markup.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.hint.size">
        <source>netzhirsch_ai_tag.hint.size</source>
        <target>"%file%" ist mit %width%×%height% Pixeln zu klein fuer eine lesbare Kennzeichnung. Sie erscheint nur als Textalternative im Markup.</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.label">
        <source>netzhirsch_ai_tag.preview.label</source>
        <target>Vorschau der Kennzeichnung</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.preview.plain">
