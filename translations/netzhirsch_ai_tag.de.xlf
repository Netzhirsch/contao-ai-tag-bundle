      <trans-unit id="netzhirsch_ai_tag.label">
        <source>netzhirsch_ai_tag.label</source>
        <target>KI-generiert</target>
        <note>Gesetzliche Standardformulierung fuer die Bildkennzeichnung. So kurz wie moeglich, damit sie auch in kleinen Bildgroessen lesbar bleibt.</note>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.flag_set">
        <source>netzhirsch_ai_tag.log.flag_set</source>
        <target>KI-Kennzeichnung gesetzt: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.flag_unset">
        <source>netzhirsch_ai_tag.log.flag_unset</source>
        <target>KI-Kennzeichnung entfernt: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.text_changed">
        <source>netzhirsch_ai_tag.log.text_changed</source>
        <target>Wortlaut der KI-Kennzeichnung geändert: %path%</target>
      </trans-unit>
      <trans-unit id="netzhirsch_ai_tag.log.position_changed">
        <source>netzhirsch_ai_tag.log.position_changed</source>
