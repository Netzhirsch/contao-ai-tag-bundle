{
    "name": "netzhirsch/contao-ai-tag-bundle",
    "type": "contao-bundle",
    "description": "Kennzeichnung KI-generierter Bilder in Contao 5.3+ nach Art. 50 EU AI Act - eingebrannt in jede erzeugte Bildgroesse, sprachsensitiv, mit Nachweisprotokoll.",
    "keywords": ["contao", "ai-act", "ai-labelling", "images", "compliance"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Netzhirsch GmbH",
            "homepage": "https://www.netzhirsch.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3",
        "contao/image": "^1.2",
        "doctrine/dbal": "^3.6 || ^4.0",
        "imagine/imagine": "^1.3",
        "psr/log": "^3.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/filesystem": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "symfony/translation-contracts": "^3.0",
        "twig/twig": "^3.10"
    },
    "suggest": {
        "netzhirsch/contao-mcp-bundle": "Stellt den MCP-Server; erst damit stehen die Werkzeuge netzhirsch_ai_tag_get/list/set zur Verfuegung (nach Freigabe durch den Betreiber)."
    },
    "repositories": {
        "netzhirsch-mcp": {
            "type": "vcs",
            "url": "https://github.com/Netzhirsch/contao-mcp-bundle.git"
        }
    },
    "require-dev": {
        "contao/easy-coding-standard": "^6.0",
        "contao/manager-plugin": "^2.0",
        "netzhirsch/contao-mcp-bundle": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Netzhirsch\\ContaoAiTagBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netzhirsch\\ContaoAiTagBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Netzhirsch\\ContaoAiTagBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "all": [
            "@ecs",
            "@phpstan",
            "@rector",
            "@unit-tests"
        ],
        "ecs": "@php vendor/bin/ecs check --fix --ansi",
        "phpstan": "@php vendor/bin/phpstan analyse --ansi",
        "rector": "@php vendor/bin/rector process --dry-run --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "contao/manager-plugin": true,
            "cweagans/composer-patches": true,
            "contao-components/installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
